{
  "name": "dsh-netproxy",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) network proxy plugin: a built-in forward proxy engine (HTTP + CONNECT) plus a Settings-page control plane that routes ALL DSH outbound traffic (LLM inference, web tools, other plugins, curl/git subprocesses) through a configurable proxy with hot switching, per-request error reporting, and optional MITM-proxy CA trust.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./engine": "./lib/engine.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-netproxy-engine": "lib/engine.js"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "engine": "node lib/engine.js",
    "check": "node --check lib/engine.js && node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "dshClient": {
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-primitives"
    ],
    "platform": "web"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^7.29.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
